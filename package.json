{
  "name": "send-to-manyfold",
  "version": "0.1.0",
  "private": true,
  "description": "Send 3D models from Printables, Thingiverse and MakerWorld to your Manyfold instance.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/run.ts",
    "test:built": "wxt build && REQUIRE_BUILT_MANIFEST=1 vitest run src/offscreen/worker-gate.test.ts",
    "postinstall": "wxt prepare",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.6",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "happy-dom": "20.14.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
